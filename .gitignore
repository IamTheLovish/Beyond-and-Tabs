local/
*.png
*.assets
*.resS
__pycache__/
mod/build/
mod/run/
mod/.gradle/
.gradle/

# our own original art ships with the mod (game assets stay excluded by the rule above)
!mod/src/main/resources/assets/beyondtabs/**/*.png

# Reign of Nether fork assets (textures, icons) and agent worktrees
!bar/src/main/resources/**/*.png
.claude/
javac.*.args

# generated by CI (build.yml "Count the development time")
bar/src/main/resources/assets/reignofnether/devtime.json
.x-sync.md

# generated by tools/gen_blocks.py (textures + animation .mcmeta) - CI builds the pack; never commit its output
resourcepacks/BeyondAndTabs-Realistic/assets/

# generated by tools/mesh_export.py (build.yml job bar runs it before the build) - mesh bodies, spec 1
bar/src/main/resources/assets/reignofnether/meshes/*.bmesh
